# ── API service (Render > bazunk-api > Environment) ──
DATABASE_URL=postgresql://user:pass@host:5432/bazunk
SESSION_SECRET=long-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
PUBLIC_BASE_URL=https://bazunk-web.onrender.com
PUBLIC_API_URL=https://bazunk-api.onrender.com
CORS_ORIGINS=https://bazunk-web.onrender.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
EMAIL_FROM=Bazunk <no-reply@yourdomain.com>
# Optional: LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, DIDIT_CLIENT_ID, DIDIT_CLIENT_SECRET,
#           DIDIT_WEBHOOK_SECRET, RAPIDAPI_KEY, CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY

# ── Frontend (Render > bazunk-web > Environment; baked in at BUILD time) ──
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_API_URL=https://bazunk-api.onrender.com
